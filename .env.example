# Postgres connection string (Neon, Supabase, or local).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/karaoke"

# Auth.js. Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails that become super users when they sign in.
SUPER_USER_EMAILS=""
