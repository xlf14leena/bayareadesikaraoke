// Data model for BayAreaDesiKaraoke. See the product spec, "Data model sketch".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- People and sign-in (Auth.js tables + app fields) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isSuperUser   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  adminOf  GroupAdmin[]
  signUps  SignUp[]     @relation("SignUpUser")
  reviewed SignUp[]     @relation("SignUpReviewer")
}

// Google account link (Auth.js). providerAccountId is the Google id.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Groups ----------

model Group {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  bannerUrl   String?
  zelleName   String?
  zelleHandle String? // Zelle email or phone
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admins GroupAdmin[]
  series EventSeries[]
}

model GroupAdmin {
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

// ---------- Events ----------

enum Visibility {
  PUBLIC
  PRIVATE
}

enum Frequency {
  ONCE
  WEEKLY
  BIWEEKLY
  MONTHLY
}

// Template that generates EventDates. All times are Pacific (America/Los_Angeles).
model EventSeries {
  id                      String     @id @default(cuid())
  groupId                 String
  title                   String
  description             String?
  venueName               String
  venueAddress            String
  theme                   String? // blank = no theme
  themeRequired           Boolean    @default(true) // songs must fit the theme
  visibility              Visibility @default(PUBLIC)
  privateToken            String?    @unique
  // Schedule rule
  frequency               Frequency  @default(ONCE)
  monthlyWeekOfMonth      Int? // e.g. 2 for "2nd Saturday"; -1 for "last"
  startTime               String // "19:00" local time
  endTime                 String // "22:00" local time
  firstDate               DateTime   @db.Date
  endDate                 DateTime?  @db.Date
  // Pricing and capacity (USD cents)
  singerPriceCents        Int        @default(0)
  listenerPriceCents      Int        @default(0)
  maxSingers              Int? // null = no cap
  maxListeners            Int? // null = no cap
  bannerUrl               String?
  // Sign-up window, relative to each date's start (null = defaults in spec)
  signupOpensHoursBefore  Int?
  signupClosesHoursBefore Int?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  group Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dates EventDate[]

  @@index([groupId])
}

enum EventDateStatus {
  SCHEDULED
  CANCELLED
  DELETED // removed by an admin; kept so the schedule doesn't create it again
}

// One occurrence. The series is its template: the date uses the series' theme,
// description, prices and caps unless that setting is listed in overrides
// ("theme", "description", "pricing", "capacity"), in which case the date's
// own columns apply. See settingsFor in src/lib/events.ts.
model EventDate {
  id                 String          @id @default(cuid())
  seriesId           String
  startsAt           DateTime
  endsAt             DateTime
  // Set when an admin moved this date: the schedule slot it came from.
  originalStartsAt   DateTime?
  overrides          String[]        @default([])
  theme              String?
  themeRequired      Boolean         @default(true)
  description        String?
  signupsOpen        Boolean         @default(false) // admin allows registration per date
  singerPriceCents   Int?
  listenerPriceCents Int?
  maxSingers         Int?
  maxListeners       Int?
  bannerUrl          String? // null = the series' banner
  signupOpensAt      DateTime?
  signupClosesAt     DateTime?
  status             EventDateStatus @default(SCHEDULED)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  series  EventSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  signUps SignUp[]
  songs   Song[]

  @@unique([seriesId, startsAt])
  @@index([startsAt])
}

// ---------- Sign-ups and songs ----------

enum AttendeeRole {
  SINGER
  LISTENER
}

enum SignUpStatus {
  WAITLISTED // event full for this role; waitlistedAt sets the order
  RESERVED // awaiting screenshot, 24 h
  UNDER_REVIEW
  CONFIRMED
  REJECTED // awaiting new screenshot, 24 h
  EXPIRED
  CANCELLED
}

model SignUp {
  id             String       @id @default(cuid())
  eventDateId    String
  userId         String? // null when added by an admin without an account
  displayName    String
  email          String?
  role           AttendeeRole
  status         SignUpStatus @default(RESERVED)
  memoCode       String       @unique // e.g. BADK-7Q4M
  amountDueCents Int
  screenshotKey  String? // private storage key
  registeredAt   DateTime     @default(now()) // when the person signed up for this date
  reservedUntil  DateTime?
  waitlistedAt   DateTime?
  addedByAdmin   Boolean      @default(false)
  paymentNote    String? // e.g. "cash at door"
  reviewedById   String?
  reviewedAt     DateTime?
  reviewReason   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  eventDate  EventDate @relation(fields: [eventDateId], references: [id], onDelete: Cascade)
  user       User?     @relation("SignUpUser", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy User?     @relation("SignUpReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  songs      Song[]

  // one sign-up per account per date (no guest sign-ups)
  @@unique([eventDateId, userId])
  @@index([eventDateId, status])
}

enum SongStatus {
  ACTIVE
  REJECTED
  RELEASED
}

// First pick wins. A singer has up to two songs per event date, one per round.
// Duplicates are checked across both rounds: uniqueness among ACTIVE songs per
// event date (title and YouTube video) and one ACTIVE song per sign-up per round
// are enforced by partial unique indexes in the migration SQL (Prisma can't
// express them).
model Song {
  id              String     @id @default(cuid())
  signUpId        String
  eventDateId     String
  round           Int // 1 or 2
  title           String
  normalizedTitle String
  artist          String?
  youtubeUrl      String?
  youtubeVideoId  String?
  // The song time: when this title was entered. Priority goes by this time,
  // not by registration time. Changing the title releases this row and
  // creates a new one with a fresh enteredAt (history is kept). Editing only
  // the YouTube link or artist updates this row and keeps enteredAt.
  enteredAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  releasedAt      DateTime?
  status          SongStatus @default(ACTIVE)
  rejectReason    String?

  signUp    SignUp    @relation(fields: [signUpId], references: [id], onDelete: Cascade)
  eventDate EventDate @relation(fields: [eventDateId], references: [id], onDelete: Cascade)

  @@index([eventDateId, enteredAt])
}
