// Data model for BayAreaDesiKaraoke. See the product spec, "Data model sketch".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- People and sign-in (Auth.js tables + app fields) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isSuperUser   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  adminOf  GroupAdmin[]
  signUps  SignUp[]        @relation("SignUpUser")
  reviewed SignUp[]        @relation("SignUpReviewer")
  checkIns SignUp[]        @relation("SignUpCheckedInBy")
  comments EventComment[]
  feedback EventFeedback[]
}

// Google account link (Auth.js). providerAccountId is the Google id.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Groups ----------

model Group {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  bannerUrl   String?
  zelleName   String?
  zelleHandle String? // Zelle email or phone
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admins GroupAdmin[]
  series EventSeries[]
}

model GroupAdmin {
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

// ---------- Events ----------

enum Visibility {
  PUBLIC
  PRIVATE
}

enum Frequency {
  ONCE
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SlotMode {
  PICK // a checked-in singer picks any free slot
  CHECKIN_ORDER // slots go out in the order singers check in
}

// Template that generates EventDates. All times are Pacific (America/Los_Angeles).
model EventSeries {
  id                      String     @id @default(cuid())
  groupId                 String
  title                   String
  description             String?
  venueName               String
  venueAddress            String
  theme                   String? // blank = no theme
  themeRequired           Boolean    @default(true) // songs must fit the theme
  visibility              Visibility @default(PUBLIC)
  privateToken            String?    @unique
  // Schedule rule
  frequency               Frequency  @default(ONCE)
  monthlyWeekOfMonth      Int? // e.g. 2 for "2nd Saturday"; -1 for "last"
  startTime               String // "19:00" local time
  endTime                 String // "22:00" local time
  firstDate               DateTime   @db.Date
  endDate                 DateTime?  @db.Date
  // Pricing and capacity (USD cents)
  singerPriceCents        Int        @default(0)
  listenerPriceCents      Int        @default(0)
  maxSingers              Int? // null = no cap
  maxListeners            Int? // null = no cap
  bannerUrl               String?
  // Sign-up window, relative to each date's start (null = defaults in spec)
  signupOpensHoursBefore  Int?
  signupClosesHoursBefore Int?
  // How singers get their place in each round once they check in (src/lib/slots.ts)
  round1SlotMode          SlotMode   @default(PICK)
  round2SlotMode          SlotMode   @default(CHECKIN_ORDER)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  group Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dates EventDate[]

  @@index([groupId])
}

enum EventDateStatus {
  SCHEDULED
  CANCELLED
  DELETED // removed by an admin; kept so the schedule doesn't create it again
}

// One occurrence. The series is its template: the date uses the series' theme,
// description, prices and caps unless that setting is listed in overrides
// ("theme", "description", "pricing", "capacity"), in which case the date's
// own columns apply. See settingsFor in src/lib/events.ts.
model EventDate {
  id                 String          @id @default(cuid())
  seriesId           String
  startsAt           DateTime
  endsAt             DateTime
  // Set when an admin moved this date: the schedule slot it came from.
  originalStartsAt   DateTime?
  overrides          String[]        @default([])
  theme              String?
  themeRequired      Boolean         @default(true)
  description        String?
  signupsOpen        Boolean         @default(false) // admin opens sign-ups per date
  singerPriceCents   Int?
  listenerPriceCents Int?
  maxSingers         Int?
  maxListeners       Int?
  bannerUrl          String? // null = the series' banner
  signupOpensAt      DateTime?
  signupClosesAt     DateTime?
  status             EventDateStatus @default(SCHEDULED)
  // In-person check-in (src/lib/checkin.ts). Set while an admin has check-in
  // open; the secret signs the rotating QR codes, so closing check-in (or
  // opening it again) makes every earlier code useless.
  checkInOpenedAt    DateTime?
  checkInSecret      String?
  // Who's singing right now, set by an admin from the running order (round and slot)
  nowRound           Int?
  nowSlot            Int?
  // Comments and questions on the event page; an admin can turn them off per date
  commentsEnabled    Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  series   EventSeries     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  signUps  SignUp[]
  songs    Song[]
  slots    RoundSlot[]
  comments EventComment[]
  feedback EventFeedback[]

  @@unique([seriesId, startsAt])
  @@index([startsAt])
}

// ---------- Sign-ups and songs ----------

enum AttendeeRole {
  SINGER
  LISTENER
}

enum SignUpStatus {
  WAITLISTED // event full for this role; waitlistedAt sets the order
  RESERVED // awaiting screenshot, 24 h
  UNDER_REVIEW
  CONFIRMED
  REJECTED // awaiting new screenshot, 24 h
  EXPIRED
  CANCELLED
}

enum CheckInMethod {
  SCAN // the person scanned the QR code shown at the venue
  ADMIN // an admin checked them in by hand
}

model SignUp {
  id             String         @id @default(cuid())
  eventDateId    String
  userId         String? // null when added by an admin without an account
  displayName    String
  email          String?
  role           AttendeeRole
  status         SignUpStatus   @default(RESERVED)
  memoCode       String         @unique // e.g. BADK-7Q4M
  amountDueCents Int
  screenshotKey  String? // unused; the screenshot lives in PaymentScreenshot
  registeredAt   DateTime       @default(now()) // when the person signed up for this date
  reservedUntil  DateTime?
  waitlistedAt   DateTime?
  addedByAdmin   Boolean        @default(false)
  paymentNote    String? // e.g. "cash at door"
  reviewedById   String?
  reviewedAt     DateTime?
  reviewReason   String?
  // Arrival at the venue: the server's time when they checked in, and how.
  checkedInAt    DateTime?
  checkInMethod  CheckInMethod?
  checkedInById  String? // the admin, for a check-in done by hand
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  eventDate   EventDate          @relation(fields: [eventDateId], references: [id], onDelete: Cascade)
  user        User?              @relation("SignUpUser", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy  User?              @relation("SignUpReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  checkedInBy User?              @relation("SignUpCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  songs       Song[]             @relation("SongSinger")
  duetSongs   Song[]             @relation("DuetPartner") // other singers' duets that name this person
  screenshot  PaymentScreenshot?
  roundSlots  RoundSlot[]

  // one sign-up per account per date (no guest sign-ups)
  @@unique([eventDateId, userId])
  @@index([eventDateId, status])
}

// The Zelle payment screenshot for a sign-up, kept in the database so it stays
// private: only the person, that group's admins and super users can open it
// (src/app/api/screenshots/[signUpId]/route.ts). A new upload replaces it.
model PaymentScreenshot {
  signUpId    String   @id
  contentType String
  bytes       Bytes
  uploadedAt  DateTime @default(now())

  signUp SignUp @relation(fields: [signUpId], references: [id], onDelete: Cascade)
}

enum SongStatus {
  ACTIVE
  REJECTED
  RELEASED
}

// First pick wins. A singer has up to two songs per event date, one per round.
// Duplicates are checked across both rounds: uniqueness among ACTIVE songs per
// event date (title and YouTube video) and one ACTIVE song per sign-up per round
// are enforced by partial unique indexes in the migration SQL (Prisma can't
// express them).
model Song {
  id              String     @id @default(cuid())
  signUpId        String
  eventDateId     String
  round           Int // 1 or 2
  title           String
  normalizedTitle String
  artist          String?
  youtubeUrl      String?
  youtubeVideoId  String?
  duet            Boolean    @default(false) // solo unless the singer marks it a duet
  duetPartnerId   String? // optional: another sign-up for the same date singing this duet
  // The song time: when this title was entered. Priority goes by this time,
  // not by registration time. Changing the title releases this row and
  // creates a new one with a fresh enteredAt (history is kept). Editing only
  // the YouTube link or artist updates this row and keeps enteredAt.
  enteredAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  releasedAt      DateTime?
  status          SongStatus @default(ACTIVE)
  rejectReason    String?

  signUp      SignUp    @relation("SongSinger", fields: [signUpId], references: [id], onDelete: Cascade)
  duetPartner SignUp?   @relation("DuetPartner", fields: [duetPartnerId], references: [id], onDelete: SetNull)
  eventDate   EventDate @relation(fields: [eventDateId], references: [id], onDelete: Cascade)

  @@index([eventDateId, enteredAt])
}

// A checked-in singer's place in a round's running order (slot 1 sings
// first). One singer per slot and one slot per singer per round. Freed when
// the sign-up ends or its check-in is undone.
model RoundSlot {
  eventDateId String
  round       Int // 1 or 2
  slot        Int // 1, 2, 3...
  signUpId    String
  method      SlotMode // picked by the singer, or given in check-in order
  assignedAt  DateTime @default(now())

  eventDate EventDate @relation(fields: [eventDateId], references: [id], onDelete: Cascade)
  signUp    SignUp    @relation(fields: [signUpId], references: [id], onDelete: Cascade)

  @@id([eventDateId, round, slot])
  @@unique([signUpId, round])
}

// ---------- Feedback ----------

// What a signed-in person thought of an event date, given once it has ended
// (src/lib/feedback.ts). One response per person per date; sending the form
// again updates it. Only that group's admins and super users can read them.
model EventFeedback {
  id          String   @id @default(cuid())
  eventDateId String
  userId      String
  rating      Int // 1 to 5 stars
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eventDate EventDate @relation(fields: [eventDateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventDateId, userId])
  @@index([userId])
}

// ---------- Comments ----------

// A comment or question on an event date's page, from a signed-in member.
// A reply (parentId set) answers a top-level comment; replies don't nest
// further. The author or the group's admins can delete it, which deletes its
// replies too (src/app/g/[slug]/[event]/comment-actions.ts).
model EventComment {
  id          String   @id @default(cuid())
  eventDateId String
  userId      String? // null once the account is deleted; authorName stays
  authorName  String
  parentId    String?
  isQuestion  Boolean  @default(false)
  body        String
  createdAt   DateTime @default(now())

  eventDate EventDate      @relation(fields: [eventDateId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent    EventComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   EventComment[] @relation("CommentReplies")

  @@index([eventDateId, createdAt])
  @@index([parentId])
}
